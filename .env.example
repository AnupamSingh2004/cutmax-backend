# Copy to .env and fill in real values. Never commit .env — it's gitignored.

# Postgres connection string
DATABASE_URL="postgresql://cutmax:cutmax_dev_password@localhost:5432/cutmax"

# Redis (rate limiting, account lockout counters)
REDIS_URL="redis://localhost:6379"

# JWT signing secrets — must each be at least 32 characters. Generate with:
#   openssl rand -base64 48
CUSTOMER_JWT_SECRET="replace-with-a-random-32-plus-character-secret"
ADMIN_JWT_SECRET="replace-with-a-different-random-32-plus-character-secret"

# Comma-separated list of origins allowed to call this API with credentials
ALLOWED_ORIGINS="http://localhost:3001,http://localhost:3000"

# Local file storage for product images — used when STORAGE_DRIVER=local (default)
UPLOADS_DIR="./uploads"
UPLOADS_PUBLIC_BASE_URL="http://localhost:3000/api/uploads"
MAX_UPLOAD_MB=5

# STORAGE_DRIVER: "local" (default, zero-config) or "s3" for an S3-compatible
# bucket in production (built against Cloudflare R2, but any S3-compatible
# provider works — just point S3_ENDPOINT at it).
#
# To set up R2: Cloudflare dashboard -> R2 -> create a bucket -> "Manage R2
# API Tokens" -> create a token with Object Read & Write scoped to that
# bucket (gives you S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY and the account-ID
# endpoint). Then either enable the bucket's public "r2.dev" URL or attach a
# custom domain, and use that as S3_PUBLIC_BASE_URL.
STORAGE_DRIVER="local"
S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="cutmax-media"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL="https://media.yourdomain.com"

# Outbound email (enquiry/admin notifications). "smtp" works with the mailhog
# container from docker-compose.yml for local dev.
EMAIL_PROVIDER="smtp"
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_FROM="CutMax Technologies <no-reply@cutmax.local>"

# "production" enables Secure/SameSite=None cookies — only set this on HTTPS
NODE_ENV="development"
PORT=3000
