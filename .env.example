# Copy to .env and fill in real values. Never commit .env — it's gitignored.

# Postgres connection string
DATABASE_URL="postgresql://cutmax:cutmax_dev_password@localhost:5432/cutmax"

# Redis (rate limiting, account lockout counters)
REDIS_URL="redis://localhost:6379"

# JWT signing secrets — must each be at least 32 characters. Generate with:
#   openssl rand -base64 48
CUSTOMER_JWT_SECRET="replace-with-a-random-32-plus-character-secret"
ADMIN_JWT_SECRET="replace-with-a-different-random-32-plus-character-secret"

# Comma-separated list of origins allowed to call this API with credentials
ALLOWED_ORIGINS="http://localhost:3001,http://localhost:3000"

# Local file storage for product images
UPLOADS_DIR="./uploads"
UPLOADS_PUBLIC_BASE_URL="http://localhost:3000/api/uploads"
MAX_UPLOAD_MB=5

# Outbound email (enquiry/admin notifications). "smtp" works with the mailhog
# container from docker-compose.yml for local dev.
EMAIL_PROVIDER="smtp"
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_FROM="CutMax Technologies <no-reply@cutmax.local>"

# "production" enables Secure/SameSite=None cookies — only set this on HTTPS
NODE_ENV="development"
PORT=3000
